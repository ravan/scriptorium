{
  "name": "whitepaper",
  "description": "SUSE-branded whitepaper: cover page with logo, section-per-page structure, figures every few pages, references at the end.",
  "font": { "heading": "SUSE", "body": "SUSE" },
  "colors": {
    "heading": "0C322C",
    "text": "1D1D1D",
    "accent": "30BA78",
    "muted": "6F6F6F",
    "hairline": "DCDBDC",
    "calloutBg": "EAFAF4",
    "coverBg": "0C322C",
    "coverText": "FFFFFF",
    "coverMuted": "90EBCD"
  },
  "assets": {
    "logo": "../../shared/suse/logo-green.svg",
    "logoDark": "../../shared/suse/logo-white.svg",
    "fontsDir": "../../shared/suse/fonts"
  },
  "page": { "size": "A4", "marginCm": 2.2 },
  "cover": true,
  "h1PageBreak": false,
  "rules": {
    "bulletsAllowed": true,
    "maxWords": 6000,
    "minWords": 1500,
    "figureEveryWords": 900
  }
}
