{
  "name": "amazon-6pager",
  "description": "Amazon-style narrative memo: six pages of prose read in silence before a decision meeting. No bullets, no cover, plain and dense.",
  "font": { "heading": "SUSE", "body": "SUSE" },
  "colors": {
    "heading": "0C322C",
    "text": "1D1D1D",
    "accent": "30BA78",
    "muted": "6F6F6F",
    "hairline": "DCDBDC",
    "calloutBg": "EFEFEF",
    "coverBg": "FFFFFF",
    "coverText": "0C322C",
    "coverMuted": "6F6F6F"
  },
  "assets": {
    "logo": "../../shared/suse/logo-green.svg",
    "logoDark": "../../shared/suse/logo-white.svg",
    "fontsDir": "../../shared/suse/fonts"
  },
  "page": { "size": "A4", "marginCm": 2.0 },
  "cover": false,
  "h1PageBreak": false,
  "rules": {
    "bulletsAllowed": false,
    "maxWords": 3300,
    "minWords": 1800,
    "figureEveryWords": 0
  }
}
